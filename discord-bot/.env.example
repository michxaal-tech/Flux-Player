# Discord Developer Portal → your application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set for instant command registration in one server while testing.
# Leave unset to register globally (takes up to ~1 hour to propagate).
DISCORD_GUILD_ID=

# platform.claude.com → API key. Billed separately from a Claude subscription.
ANTHROPIC_API_KEY=

# Model the bot uses for /code. Defaults to claude-sonnet-5 if unset.
CLAUDE_MODEL=claude-sonnet-5

# Absolute path to the ONE repo checkout the bot is allowed to touch.
# Claude cannot read/write/run commands outside this directory.
WORKSPACE_DIR=/path/to/your/repo/checkout

# REQUIRED. Comma-separated Discord user IDs allowed to run /code.
# The bot refuses to start if this is empty.
ALLOWED_USER_IDS=

# Optional. Comma-separated channel IDs; if set, /code only works in these channels.
ALLOWED_CHANNEL_IDS=

# Optional. Overrides the default tool allowlist (Read,Write,Edit,Bash,Glob,Grep).
ALLOWED_TOOLS=
